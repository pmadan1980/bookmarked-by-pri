# --- required ---
# Any long random string. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
# The ONLY email allowed to be the owner:
OWNER_EMAIL="you@example.com"
# Public base URL of the site (no trailing slash). Locally:
APP_URL="http://localhost:3000"   # on Netlify, set to your https://<site>.netlify.app URL

# --- database ---
# Postgres connection string (Neon works great, free). Used both locally and on Netlify.
# Example: postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://USER:PASS@HOST/DB?sslmode=require"

# --- email (magic link) ---
# Get a free key at https://resend.com. If BLANK, the magic link is printed to the server console (dev only).
RESEND_API_KEY=""
# Verified sender. For quick testing Resend allows: onboarding@resend.dev
EMAIL_FROM="Bookmarked <onboarding@resend.dev>"
