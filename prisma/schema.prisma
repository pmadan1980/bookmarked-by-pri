generator client {
  provider      = "prisma-client-js"
  // "native" = your local machine; the rhel target is the AWS Lambda that Netlify runs functions on.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Book {
  id         String   @id @default(cuid())
  title      String
  author     String
  genre      String   @default("unfiled")
  shelf      String   @default("tbr") // reading | finished | tbr
  verdict    String   @default("no verdict yet")
  rating     String   @default("unread") // ★ string or "unread"
  jacketIndex Int     @default(0)
  coverUrl   String?
  slug       String   @unique
  sortOrder  Int      @default(0)
  finishedAt DateTime?
  createdAt  DateTime @default(now())
  quotes     Quote[]
  reactions  Reaction[]
}

model Quote {
  id        String   @id @default(cuid())
  book      Book?    @relation(fields: [bookId], references: [id], onDelete: SetNull)
  bookId    String?
  text      String
  source    String   @default("")
  createdAt DateTime @default(now())
}

model Note {
  id        String   @id @default(cuid())
  name      String   @default("a stranger")
  body      String
  subject   String   @default("the wall")
  approved  Boolean  @default(false)
  hidden    Boolean  @default(false)
  ipHash    String?
  createdAt DateTime @default(now())
}

model Reaction {
  id         String   @id @default(cuid())
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId     String
  kind       String
  visitorHash String
  createdAt  DateTime @default(now())
  @@unique([bookId, kind, visitorHash])
}

model VerificationToken {
  token     String   @id
  email     String
  expires   DateTime
}

model Setting {
  key   String @id
  value String
}
